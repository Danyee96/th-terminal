# Copy this file to .env and adjust. Never commit your real .env.

# Port the web server listens on (hosting platforms set this for you)
PORT=3000

# Where prices come from: nasdaq (free, no key) | simulated (offline demo)
DATA_PROVIDER=nasdaq

# Optional: free Finnhub key for real-time trade streaming (https://finnhub.io/register)
# Free plan streams up to 50 symbols; the largest stocks are subscribed first.
FINNHUB_API_KEY=
FINNHUB_MAX_SYMBOLS=50

# How often to poll for quotes, in milliseconds (minimum 5000)
QUOTE_POLL_MS=15000

# Daily history to load, and how often to refresh it (minutes)
HISTORY_YEARS=2
HISTORY_REFRESH_MIN=360

# Parallel requests when loading history
FETCH_CONCURRENCY=4

CACHE_DIR=data/cache
LOG_LEVEL=info

# ---------------- Crypto module ----------------
# Turn the crypto module off entirely
CRYPTO_ENABLED=true
# Optional free CoinGecko Demo key for higher rate limits (https://www.coingecko.com/en/api)
COINGECKO_API_KEY=
# Whale detection thresholds (USD unless noted)
WHALE_TRADE_USD=1000000
WHALE_TRADE_USD_ALTS=250000
WHALE_STREAM_COINS=10
WHALE_BTC_ONCHAIN=100
LIQUIDATION_WHALE_USD=100000

# Persistent account/session/API settings directory (default: data/auth)
# AUTH_DATA_DIR=data/auth
# Optional initial password for the four test accounts (first startup only)
# TEST_ACCOUNT_PASSWORD=
# Set to 1 only when deployed behind one trusted reverse proxy
TRUST_PROXY=0

# Temporary public credential autofill for the four testing accounts
# Set false when testing is finished (including on live hosting).
TEST_LOGIN_BUTTONS=true
