{
  "name": "th-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "TH Terminal: market heat map, screener and charts powered by the TH Toolkit indicators",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:sim": "DATA_PROVIDER=simulated node --watch src/server.js",
    "clear-cache": "node -e \"import('node:fs').then(f=>f.rmSync('data/cache',{recursive:true,force:true}))\"",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ws": "^8.18.0"
  }
}
